# ---------------------------------------------------------------------------
# backend/.env  ·  Copia este archivo a backend/.env y rellena lo que necesites
# ---------------------------------------------------------------------------
# Ninguna de estas variables llega al navegador: viven solo en el servidor.
# El backend arranca igual sin .env (todo tiene un valor por defecto sensato).
# ---------------------------------------------------------------------------

# Puerto del backend. El frontend apunta aquí por defecto (VITE_API_URL).
PORT=8000

# Orígenes autorizados a llamar al backend (separados por coma).
# 5173 es el puerto por defecto de Vite en desarrollo.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Secreto para firmar los tokens de sesión. CÁMBIALO antes de subir a la nube.
JWT_SECRETO=cambia-esto-en-produccion

# ---------------------------------------------------------------------------
# NASA FIRMS — focos de calor en tiempo real (Capa 3)
# ---------------------------------------------------------------------------
# AQUÍ va tu MAP_KEY. Es el sitio correcto: el navegador nunca la ve.
# Consíguela gratis en https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Pégala en la línea de abajo (sin comillas) y reinicia el backend.
NASA_FIRMS_MAP_KEY=
# Satélite/producto. VIIRS_SNPP_NRT va bien; hay también VIIRS_NOAA20_NRT, MODIS_NRT.
NASA_FIRMS_FUENTE=VIIRS_SNPP_NRT
# Días hacia atrás a consultar (1–10).
NASA_FIRMS_DIAS=5

# ---------------------------------------------------------------------------
# SUPABASE — base de datos (opcional)
# ---------------------------------------------------------------------------
# Si rellenas estas dos variables, el backend guarda TODO (usuarios, sesiones,
# escenarios, alertas, calibraciones, bitácora e informes) en tu base de datos.
# Si las dejas vacías, usa los JSON de almacen/datos/ y funciona igual.
#
# Pasos:
#   1. Crea un proyecto en https://supabase.com
#   2. SQL Editor → pega y ejecuta backend/sql/01_esquema.sql
#      (y opcionalmente 02_semilla.sql para los usuarios demo)
#   3. Project Settings → API → copia:
#        · Project URL           → SUPABASE_URL
#        · service_role (secret) → SUPABASE_SERVICE_KEY
#      OJO: usa la service_role, NO la anon key. Y no la subas a git.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Rutas y datos (normalmente no hace falta tocar)
# ---------------------------------------------------------------------------
CSV_DIR=./datos
DATOS_DIR=./almacen/datos
CACHE_DIR=./.cache
PRECALENTAR=true
